rules_version = '2';

// Guests order without signing in, so orders accept a null userId. A guest may
// create an order but never read one back — with a single permissive read rule,
// the config in the JS bundle would expose every customer's name, phone and
// address.
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is whoever has a document at admins/{uid}. Rules evaluate
    // exists() with their own privileges, so this works even though the
    // collection below is sealed to every client.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A signed-in user may read their own entry and nothing else. The panel
    // has no other way to know whether to show itself: isAdmin() above runs
    // inside the rules, where the client cannot see the answer.
    //
    // `get` is a single document by id, so this only ever tells you about
    // yourself. `list` stays closed, so the collection cannot be enumerated,
    // and writes stay closed, so nobody can add themselves — create these by
    // hand in the console.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /orders/{orderId} {
      // A row may only be attributed to the person placing it, so nobody can
      // write orders into someone else's history.
      allow create: if request.resource.data.userId == null
                    || (request.auth != null
                        && request.resource.data.userId == request.auth.uid);

      allow read: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid);

      // An admin moves an order along, gives it an estimated arrival, says why
      // they turned it down, and does nothing else to it. Prices, addresses
      // and line items are the customer's record: not editable from a browser
      // by anyone, so a stolen admin session cannot rewrite what someone
      // ordered or what they owe.
      //
      // etaAt is epoch milliseconds or null. Typed here as well as in the
      // client, because the client is the half an attacker controls: a string
      // in that field would render as a broken countdown on the customer's
      // order screen.
      //
      // cancelReason is shown to the customer verbatim, so it is bounded here
      // as well: a rejection reason is a sentence, and the field is the one
      // piece of admin-written text that lands on someone else's screen.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'etaAt', 'cancelReason', 'updatedAt'])
                    && request.resource.data.status in
                         ['new', 'confirmed', 'preparing', 'on-the-way',
                          'delivered', 'cancelled']
                    && (request.resource.data.etaAt == null
                        || request.resource.data.etaAt is number)
                    && (request.resource.data.cancelReason == null
                        || (request.resource.data.cancelReason is string
                            && request.resource.data.cancelReason.size() <= 200));

      // Only an admin, and never the customer whose order it is: a customer
      // who could delete their own row could erase the record of a bill they
      // are disputing.
      //
      // This does erase the customer's copy too — the history under their
      // Orders tab is this same collection — so the console asks before it
      // does it, and offers clearing the finished ones on their own.
      allow delete: if isAdmin();
    }

    match /offers/{offerId} {
      // Offers are meant to be seen, including by visitors who never sign in.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{key} {
      // Everyone reads this: it is what tells a visitor whether the shop is
      // open, and that answer cannot be behind a sign-in. Only an admin
      // writes it — the alternative is a customer opening the shop.
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anything not matched above is denied.
  }
}
