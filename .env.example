# Supabase — optional. Without these the site still works exactly as before:
# guest ordering over WhatsApp, no accounts, no prescription storage.
# Find both in your project's Settings -> API.

# https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# The "publishable" key (sb_publishable_...). Safe to ship in the browser
# bundle; it is protected by the Row Level Security policies in
# supabase/migrations. Never put a secret / service_role key in a VITE_ var —
# those are readable by anyone who loads the site.
VITE_SUPABASE_PUBLISHABLE_KEY=
