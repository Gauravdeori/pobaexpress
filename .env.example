# Firebase — optional. Without these the site still works exactly as before:
# guest ordering over WhatsApp, no accounts, no order log.
#
# These values are NOT secret. Firebase web config is designed to ship in the
# browser bundle; access is controlled by firestore.rules.
# Copy them from Firebase console -> Project settings -> General -> Your apps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary — optional, for prescription photos. Firebase Storage needs a paid
# plan, so uploads go here instead. The upload preset must be set to
# "Unsigned" in Cloudinary -> Settings -> Upload. Neither value is a secret;
# the preset only grants uploading.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Telegram order alerts — SERVER ONLY, no VITE_ prefix. Without them the site
# behaves exactly as before: the customer's WhatsApp message is still the
# order, this is just the shop hearing about it without waiting for that.
#
# 1. Message @BotFather on Telegram -> /newbot -> copy the token.
# 2. Add the bot to the group (or message it directly), send one message, then
#    open https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id.
#    A group id is negative — keep the minus sign.
# Anyone holding the token can post to that chat as you, so treat it as a
# secret and never give it a VITE_ prefix.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
