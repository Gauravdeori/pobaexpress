# Firebase — optional. Without these the site still works exactly as before:
# guest ordering over WhatsApp, no accounts, no prescription storage.
#
# These values are NOT secret. Firebase web config is designed to ship in the
# browser bundle; access is controlled by firestore.rules and storage.rules.
# Copy them from Firebase console -> Project settings -> General -> Your apps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
