# Firebase — optional. Without these the site still works exactly as before:
# guest ordering over WhatsApp, no accounts, no order log.
#
# These values are NOT secret. Firebase web config is designed to ship in the
# browser bundle; access is controlled by firestore.rules.
# Copy them from Firebase console -> Project settings -> General -> Your apps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Email sign-in codes — SERVER ONLY. No VITE_ prefix on any of these, which is
# what keeps them out of the browser bundle. Without them the site still works;
# the code form reports that email sign-in isn't switched on, and the password
# and Google buttons carry on as before.
#
# 1. FIREBASE_SERVICE_ACCOUNT — Firebase console -> Project settings ->
#    Service accounts -> Generate new private key. Paste the whole JSON on one
#    line (or base64 it, both are accepted). This one IS a secret: it can mint
#    a session for any account. Never commit it, never prefix it with VITE_.
# 2. RESEND_API_KEY — resend.com -> API keys. The free tier is plenty.
# 3. OTP_FROM_EMAIL — a sender on a domain verified in Resend. Left unset it
#    falls back to Resend's shared address, which only delivers to the address
#    that owns the Resend account: fine for testing, not for customers.

FIREBASE_SERVICE_ACCOUNT=
RESEND_API_KEY=
OTP_FROM_EMAIL=

# Cloudinary — optional, for prescription photos. Firebase Storage needs a paid
# plan, so uploads go here instead. The upload preset must be set to
# "Unsigned" in Cloudinary -> Settings -> Upload. Neither value is a secret;
# the preset only grants uploading.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
